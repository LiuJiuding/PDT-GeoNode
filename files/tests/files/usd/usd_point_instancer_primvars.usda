#usda 1.0
(
    defaultPrim = "instances"
    metersPerUnit = 1
    upAxis = "Y"
)

def PointInstancer "instances" (
    kind = "group"
)
{
    # The third instance is hidden, so the importer's visibility mask is not a constant.
    int64[] invisibleIds = [2]
    quath[] orientations = [(1, 0, 0, 0), (1, 0, 0, 0), (1, 0, 0, 0)]
    point3f[] positions = [(0, 0, 0), (2, 0, 0), (4, 0, 0)]
    float3[] scales = [(1, 1, 1), (1, 1, 1), (1, 1, 1)]
    int[] protoIndices = [0, 0, 0]
    rel prototypes = </instances/Prototypes/Root>

    # Custom primvars: these are imported as point attributes on the point cloud.
    float3[] primvars:dir = [(0.25, 0.5, 0.75), (1, 0, 0), (0, 1, 0)] (
        interpolation = "vertex"
    )
    float[] primvars:weight = [0.5, 1.5, 2.5] (
        interpolation = "vertex"
    )
    # A uniform primvar applies its whole value to every instance, so it is imported as a
    # single-value attribute.
    float[] primvars:gain = [0.75] (
        interpolation = "uniform"
    )
    # 'mask' is a point instancer attribute in Blender (the visibility mask derived from
    # invisibleIds), so a primvar of that name is not imported.
    float[] primvars:mask = [0.125, 0.25, 0.375] (
        interpolation = "vertex"
    )

    def Scope "Prototypes" (
        kind = "group"
    )
    {
        def Xform "Root" (
            kind = "group"
        )
        {
            def Mesh "mesh_0"
            {
                float3[] extent = [(-0.5, -0.5, 0), (0.5, 0.5, 0)]
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 3, 2]
                uniform token orientation = "leftHanded"
                point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (-0.5, 0.5, 0), (0.5, 0.5, 0)] (
                    interpolation = "vertex"
                )
                uniform token subdivisionScheme = "none"
            }
        }
    }
}
